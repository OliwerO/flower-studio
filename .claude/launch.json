{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env.dev", "--watch", "src/index.js"],
      "port": 3001,
      "cwd": "backend"
    },
    {
      "name": "florist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js"],
      "port": 5173,
      "cwd": "apps/florist"
    },
    {
      "name": "harness",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/scripts/start-test-backend.js"],
      "port": 3002
    },
    {
      "name": "florist-harness",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_API_PROXY_TARGET=http://localhost:3002 node node_modules/vite/bin/vite.js --port 5176"],
      "port": 5176,
      "cwd": "apps/florist"
    },
    {
      "name": "dashboard-harness",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_API_PROXY_TARGET=http://localhost:3002 node node_modules/vite/bin/vite.js --port 5177"],
      "port": 5177,
      "cwd": "apps/dashboard"
    },
    {
      "name": "delivery",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js"],
      "port": 5174,
      "cwd": "apps/delivery"
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js"],
      "port": 5175,
      "cwd": "apps/dashboard"
    }
  ]
}
